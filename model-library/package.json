{
  "name": "model-library",
  "version": "0.1.0",
  "description": "Browse a library of STL and 3MF files by thumbnail",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:safe": "electron . --no-sandbox --disable-gpu",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux",
    "vendor": "node scripts/vendor-three.js",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "three": "0.160.0"
  },
  "author": "Model Library",
  "build": {
    "appId": "local.modellibrary.app",
    "productName": "ModelLibrary",
    "artifactName": "ModelLibrary-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "thumb-preload.js",
      "viewer-preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "electronVersion": "45.1.0",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "Browse STL and 3MF files by thumbnail",
      "maintainer": "Angelo Masci <angelo.a.masci@gmail.com>",
      "syncDesktopName": true,
      "executableName": "model-library",
      "desktop": {
        "entry": {
          "Name": "Model Library"
        }
      },
      "extraResources": [
        {
          "from": "vendor/7zip/linux-${arch}",
          "to": "7zip",
          "filter": [
            "7zz"
          ]
        },
        {
          "from": "vendor/7zip/License.txt",
          "to": "7zip/License.txt"
        }
      ]
    },
    "publish": null,
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2t64 | libasound2"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/7zip/win",
          "to": "7zip",
          "filter": [
            "7z.exe",
            "7z.dll"
          ]
        },
        {
          "from": "vendor/7zip/License.txt",
          "to": "7zip/License.txt"
        }
      ]
    },
    "mac": {
      "extraResources": [
        {
          "from": "vendor/7zip/mac",
          "to": "7zip",
          "filter": [
            "7zz"
          ]
        },
        {
          "from": "vendor/7zip/License.txt",
          "to": "7zip/License.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Model Library",
      "artifactName": "ModelLibrary-Setup-${version}.${ext}"
    }
  },
  "desktopName": "model-library.desktop",
  "homepage": "https://github.com/amwales-888/model-library",
  "dependencies": {
    "yauzl": "^3.4.0"
  }
}
