<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line access to a library: inspect a library.sqlite (safely, on a copy) or scan folders into one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>xandrite-lib</AssemblyName>
    <RootNamespace>Xandrite.LibraryTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xandrite.Library\Xandrite.Library.csproj" />
  </ItemGroup>

</Project>
