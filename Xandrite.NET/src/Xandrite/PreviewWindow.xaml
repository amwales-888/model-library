<Window x:Class="Xandrite.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xandrite – thumbnail preview"
        Width="980" Height="760" MinWidth="600" MinHeight="440"
        Icon="Xandrite.ico"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar ToolBarTray.IsLocked="True">
                <Button Content="Open model…" Click="OnOpen" Padding="8,2" />
                <Separator />
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="SizeBox" Width="80" SelectionChanged="OnSizeChanged" />
                <CheckBox x:Name="ZUpBox" Content="Z up" IsChecked="True" Margin="8,0,0,0"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                          ToolTip="STL and 3MF files are normally Z-up; untick for a file made Y-up." />
                <CheckBox x:Name="SoftwareBox" Content="Software renderer (WARP)" Margin="8,0,0,0"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged"
                          ToolTip="Draw with Direct3D's software rasteriser instead of the graphics card." />
                <Separator />
                <Button x:Name="SaveButton" Content="Save PNG…" Click="OnSave" IsEnabled="False" Padding="8,2" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Open or drop an .stl or .3mf file." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AdapterText" Foreground="Gray" />
            </StatusBarItem>
        </StatusBar>

        <Expander DockPanel.Dock="Right" ExpandDirection="Left" Header="View settings" IsExpanded="False">
            <TextBox x:Name="ViewStateText" Width="330" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" />
        </Expander>

        <Border Background="#C9D1D8">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform" StretchDirection="DownOnly" Margin="12"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="HintText" Text="Drop a model here" FontSize="20" Foreground="#5A6B78"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
